cabal-version:      2.4
name:               multica-api
version:            0.1.0.0
synopsis:           Haskell mirror of the Multica REST surface — board reads
description:
  A mirror of four endpoints, chosen (IRI-44) because together they are the
  smallest set that exercises both shapes the surface is known to be
  non-uniform in: bare-array vs envelope lists, and the polymorphic
  @assignee_type@ \/ @assignee_id@ pair.
  .
  * @GET \/api\/workspaces@       — bare array
  * @GET \/api\/workspaces\/{id}@ — single object
  * @GET \/api\/issues@           — envelope @{issues, total}@
  * @GET \/api\/issues\/{id}@     — single object, polymorphic assignee
  .
  Reads only. No writes, no auth flow, no pagination, no realtime.
license:            MIT
author:             Octagon Algebraist
maintainer:         iris
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:
      Board.Workspace
      Board.Actor
      Board.Issue
  build-depends:
      base    >=4.17 && <5
    , aeson   >=2.2  && <2.4
    , text    >=2.0  && <2.2
    , ubiquity
  default-language:   GHC2021
  default-extensions: DerivingStrategies
  ghc-options:        -Wall -Wcompat -Wincomplete-record-updates

executable multica-mirror
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      base    >=4.17 && <5
    , text    >=2.0  && <2.2
    , ubiquity
    , multica-api
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -threaded
