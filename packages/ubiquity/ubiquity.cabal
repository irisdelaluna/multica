cabal-version:      2.4
name:               ubiquity
version:            0.1.0.0
synopsis:           The constant sheaf — vocabulary that means the same thing in every chart
description:
  Ubiquity holds only what is genuinely constant across every bounded context:
  identifiers, timestamps, workspace scoping, the actor *carrier*, the wire
  conventions the surface actually uses, and the read transport.
  .
  It deliberately does NOT hold a universal actor sum type, a generic list
  envelope, or a priority type. See @Ubiquity.Actor@ and the module headers for
  the evidence behind each exclusion.
license:            MIT
author:             Octagon Algebraist
maintainer:         iris
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:
      Ubiquity.Identifier
      Ubiquity.Time
      Ubiquity.Wire
      Ubiquity.Actor
      Ubiquity.Scope
      Ubiquity.Transport
  build-depends:
      base             >=4.17 && <5
    , aeson            >=2.2  && <2.4
    , bytestring       >=0.11 && <0.13
    , text             >=2.0  && <2.2
    , time             >=1.12 && <1.16
    , http-client      >=0.7  && <0.8
    , http-client-tls  >=0.3  && <0.4
    , http-types       >=0.12 && <0.13
  default-language:   GHC2021
  default-extensions: DerivingStrategies
  ghc-options:        -Wall -Wcompat -Wincomplete-record-updates
